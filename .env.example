# LLM (any OpenAI-compatible API). Leave the key empty to run fully offline.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
MAX_AGENT_COMPLETION_TOKENS=450
AGENT_MAX_STEPS=6

# App
FLASK_SECRET_KEY=change-me
VALORA_DB=valora.db
VALORA_SEED=7
VALORA_TICK_SECONDS=30
PORT=5004

# Optional: PPO regulator (pip install ".[rl]")
VALORA_RL=0
